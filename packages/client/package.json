      "import": "./dist/authorization.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@appport/resolver-core": "0.2.0",
    "@appport/sdk": "^1.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/resolver.git",
    "directory": "packages/client"
  }
}

{
  "name": "@appport/resolver-client",
  "version": "0.3.0",
  "description": "Resolve references at run time with live updates, caching, last-known-good fallback and traffic steering.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

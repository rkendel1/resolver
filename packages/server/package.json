{
  "name": "@appport/resolver",
  "version": "0.3.1",
  "description": "The resolver: an AppPort host that stores typed, revisioned, steerable references on FeltDB, with AppPort Services API keys and secret custody.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "resolver": "./dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "vendor"
  ],
  "dependencies": {
    "@appport/authorization": "1.1.0",
    "@appport/core": "1.7.0",
    "@appport/protocol": "1.4.1",
    "@appport/resolver-client": "0.2.2",
    "@appport/resolver-core": "0.1.0",
    "@appport/schema": "1.1.5",
    "@appport/sdk": "1.6.0",
    "@appport/server": "1.3.0",
    "@appport/services": "0.15.0",
    "@feltdb/core": "0.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/resolver.git",
    "directory": "packages/server"
  }
}
